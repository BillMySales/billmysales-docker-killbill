# Production environment. Usage: cp .env.prod.example .env, fill in the
# REQUIRED values, then docker compose up -d
# Commented-out lines show the default value.

# ---------------------------------------------------------------------------
# Optional services, comma separated: backup, mailpit (dev only).
# ---------------------------------------------------------------------------
COMPOSE_PROFILES=backup
#COMPOSE_PROJECT_NAME=killbill

# Optional overrides (see overrides/*.yaml), combined with ":", e.g.
#COMPOSE_FILE=compose.yaml:overrides/traefik.yaml:overrides/local-dirs.yaml
# overrides/traefik.yaml: publish through an existing Traefik (then set
# SITE_ADDRESS=:80 below).
#TRAEFIK_HOST=billing.example.com
#TRAEFIK_NETWORK=shared_network
#TRAEFIK_ENTRYPOINT=websecure
#TRAEFIK_CERTRESOLVER=letsencrypt
# overrides/local-dirs.yaml: data in local directories instead of volumes.
#DATA_DIR=./data

# ---------------------------------------------------------------------------
# Site and network
# ---------------------------------------------------------------------------
# REQUIRED. Public URL of Kaui (/) and the Kill Bill API (/1.0/kb).
KILLBILL_URL=https://billing.example.com
# Caddy site address: a domain gets an automatic Let's Encrypt certificate
# (DNS must point here and ports 80/443 must be reachable). Use ":80" behind
# another TLS-terminating proxy, or "localhost" for local HTTPS.
SITE_ADDRESS=billing.example.com
# Interface to publish ports on: 0.0.0.0 = all (public server).
HTTP_BIND=0.0.0.0
#HTTP_PORT=80
#HTTPS_PORT=443

# ---------------------------------------------------------------------------
# Secrets and credentials (REQUIRED, use long random values: openssl rand -hex 24)
# ---------------------------------------------------------------------------
DB_ROOT_PASSWORD=
DB_PASSWORD=
#DB_USER=killbill
# Password of the `admin` user: Kaui login and the API (HTTP basic auth).
KILLBILL_ADMIN_PASSWORD=
# The tenant's API key and secret (X-Killbill-ApiKey / X-Killbill-ApiSecret
# headers). The secret can't be changed once the tenant exists.
KILLBILL_API_KEY=
KILLBILL_API_SECRET=
# Kaui's session secret (openssl rand -hex 64).
KAUI_SECRET_KEY_BASE=

# ---------------------------------------------------------------------------
# Tenant
# ---------------------------------------------------------------------------
# External key (name) of the tenant created on the first run.
#KILLBILL_TENANT_NAME=default
# URL Kill Bill POSTs the tenant's events to (invoice created, payment
# succeeded or failed, ...), e.g. BillMySales. Empty = none. Applied on
# every `up`.
#KILLBILL_NOTIFICATION_URL=
# Locale of the Spanish invoice texts uploaded to the tenant
# (config/killbill/InvoiceTranslation.properties). Accounts with this locale
# get them; others get Kill Bill's English defaults.
#KILLBILL_INVOICE_LOCALE=es_CL
# Company shown on Kill Bill's invoice HTML.
#KILLBILL_COMPANY_NAME=My Company
#KILLBILL_COMPANY_ADDRESS=
#KILLBILL_COMPANY_CITY=
#KILLBILL_COMPANY_COUNTRY=Chile
# Days before each invoice to emit the "upcoming invoice" event (and email),
# e.g. 3d; 0s = off.
#KILLBILL_UPCOMING_INVOICE_NOTICE=0s

# ---------------------------------------------------------------------------
# Mail (SMTP): emails to the accounts' addresses, sent by the
# killbill-email-notifications plugin. No emails without SMTP_HOST.
# ---------------------------------------------------------------------------
SMTP_HOST=
# The plugin speaks SMTPS (SMTP_SECURE=ssl, port 465) or plain SMTP
# (SMTP_SECURE=none); it has no STARTTLS-only mode (port 587).
#SMTP_PORT=465
#SMTP_SECURE=ssl
#SMTP_USER=
#SMTP_PASSWORD=
# Sender address.
#SMTP_FROM=
# Events emailed (comma separated; empty = none): invoice created, upcoming
# invoice (needs KILLBILL_UPCOMING_INVOICE_NOTICE), payment succeeded or
# failed (with refunds), subscription cancelled.
#KILLBILL_EMAIL_EVENTS=INVOICE_CREATION,INVOICE_NOTIFICATION,INVOICE_PAYMENT_SUCCESS,INVOICE_PAYMENT_FAILED,SUBSCRIPTION_CANCEL

# ---------------------------------------------------------------------------
# Versions
# ---------------------------------------------------------------------------
# A newer Kill Bill version applies its schema migrations on the next `up`
# (`migrate` service). Back up first.
#KILLBILL_VERSION=0.24.21
# Plugins baked into the Kill Bill image (image/Dockerfile), and its name.
#EMAIL_NOTIFICATIONS_VERSION=0.8.6
#KILLBILL_IMAGE=killbill-stack
#KAUI_VERSION=4.0.26
#MARIADB_VERSION=11.8
#CADDY_VERSION=2.11
#MAILPIT_VERSION=v1.31

# ---------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------
#BACKUP_INTERVAL_HOURS=24
#BACKUP_KEEP_DAYS=7

# ---------------------------------------------------------------------------
# Resources and logs
# ---------------------------------------------------------------------------
# JVM heap sizes; keep each *_MEMORY_LIMIT about 512 MiB (Kill Bill) or
# 768 MiB (Kaui, JRuby) above them.
#KILLBILL_JAVA_XMX=1g
#KAUI_JAVA_XMX=512m
#DB_MEMORY_LIMIT=1g
#KILLBILL_MEMORY_LIMIT=1536m
#KAUI_MEMORY_LIMIT=1280m
#MIGRATE_MEMORY_LIMIT=256m
#SETUP_MEMORY_LIMIT=768m
#CADDY_MEMORY_LIMIT=256m
#BACKUP_MEMORY_LIMIT=512m
#LOG_MAX_SIZE=10m
#LOG_MAX_FILE=3

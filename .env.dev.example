# Development environment. Usage: cp .env.dev.example .env && docker compose up -d
# Every variable is documented in .env.prod.example.

# Local URL (Kaui and the API), plain HTTP on port 8110.
KILLBILL_URL=http://localhost:8110
SITE_ADDRESS=:80
HTTP_PORT=8110
HTTPS_PORT=8410

# Dev-only secrets and credentials.
DB_ROOT_PASSWORD=root
DB_PASSWORD=killbill
KILLBILL_ADMIN_PASSWORD=admin12345
KILLBILL_API_KEY=dev
KILLBILL_API_SECRET=dev-secret
KAUI_SECRET_KEY_BASE=dev-secret-key-base-0123456789abcdef0123456789abcdef0123456789abcdef

# Push notifications (invoices, payments, ...) to an app running on this
# machine, e.g. BillMySales:
#KILLBILL_NOTIFICATION_URL=http://host.docker.internal:8000/killbill/callback

# Mailpit catches all outgoing mail (the email plugin's): http://localhost:8025
COMPOSE_PROFILES=mailpit
MAILPIT_PORT=8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=none
SMTP_FROM=billing@example.com
